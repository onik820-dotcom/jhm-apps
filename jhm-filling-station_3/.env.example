# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and publishable key. Safe to expose to the browser: every query
# they make is governed by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses RLS. Server-side only — the seed script, the n8n
# inbound routes and the outbound sync worker. Never prefix this NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Anthropic — meter OCR (Phase 3)
# ---------------------------------------------------------------------------
# Read only inside app/api/ocr/meter. Never sent to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# OpenAI — the chat assistant (Phase 8)
# ---------------------------------------------------------------------------
# Read only inside app/api/chat. Never sent to the browser.
#
# Note: this project uses two AI providers. Anthropic reads the meter photos
# (Section 2 of the brief locks that); OpenAI runs the chat, which the Phase 8
# brief asked for. Both keys are server-side only.
OPENAI_API_KEY=
# gpt-4o-mini is the default and is enough for this. gpt-4o understands
# transliterated Bangla noticeably better if the cost is acceptable.
OPENAI_MODEL=gpt-4o-mini
# Used only when the browser has no Bangla speech recogniser.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ---------------------------------------------------------------------------
# n8n (Phase 8)
# ---------------------------------------------------------------------------
# Where committed events are mirrored to. Unset means the queue simply fills
# and nothing is lost — a missing webhook never blocks a local write.
N8N_EVENT_WEBHOOK=
NEXT_PUBLIC_N8N_CHAT_WEBHOOK=
# Shared secret required on the inbound routes /api/n8n/chat and /api/n8n/command.
# Unset means those routes are closed, not open.
N8N_INBOUND_SECRET=
# Optional: send voice clips to n8n for transcription instead of OpenAI.
N8N_TRANSCRIBE_WEBHOOK=
# Optional: a separate bearer secret for POST /api/sync/drain. Falls back to
# N8N_INBOUND_SECRET. Vercel cron calls are recognised by their own header.
SYNC_DRAIN_SECRET=

# ---------------------------------------------------------------------------
# Seed accounts — one per role
# ---------------------------------------------------------------------------
# Used by `npm run seed` and `npm run verify:rls`. Choose real passwords; the
# seed script deliberately has no defaults, because these accounts can see the
# station's money.
SEED_DISPENSER_EMAIL=
SEED_DISPENSER_PASSWORD=
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_MD_EMAIL=
SEED_MD_PASSWORD=

# ---------------------------------------------------------------------------
# The four station accounts
# ---------------------------------------------------------------------------
# The real accounts the station signs in with, as opposed to the SEED_* test
# fixtures above. Read by `npm run check:accounts`, which signs in as each one
# and checks it lands on the right dashboard. Never committed.
STATION_ADMIN_EMAIL=
STATION_ADMIN_PASSWORD=
STATION_MD_EMAIL=
STATION_MD_PASSWORD=
STATION_MANAGER_EMAIL=
STATION_MANAGER_PASSWORD=
STATION_EMPLOYEE_EMAIL=
STATION_EMPLOYEE_PASSWORD=
